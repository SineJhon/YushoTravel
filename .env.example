# ── Yusho Travel — environment template ──────────────────────────────────────
# Copy to .env and fill in real values. All values shown here are safe dev defaults.

# LOCAL DEV (SQLite — zero setup):
DATABASE_URL="file:./dev.db"

# PRODUCTION (PostgreSQL — recommend Neon/Supabase/Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/yusho?sslmode=require"

# Secret used to sign session cookies (JWT). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Seed credentials for the initial admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@yusho.travel"
ADMIN_PASSWORD="Yusho@Admin2026"

# Public site URL used for canonical links, sitemap & Open Graph
NEXT_PUBLIC_SITE_URL="https://yushotravel.example.com"

# When true, a small badge marks seed/demo content in the admin dashboard
NEXT_PUBLIC_SHOW_DEMO_BADGE="true"

# Optional: Cloudinary-style image base URL if you upload images there and store
# full URLs. Leave unset to host uploads locally under /public/uploads.
# CLOUDINARY_BASE_URL="https://res.cloudinary.com/your-cloud/image/upload"